---
const layers = [
  ['application','APPLICATION / OCCAM','Processes express intent and exchange messages.'],
  ['vm','VM','A controlled execution boundary for experiments.'],
  ['core','T425 CORE','Scheduler, timers, channels, microcode and datapath meet here.'],
  ['service','LINK SERVICE','A boundary between logical channels and physical work.'],
  ['phy','PHY','The physical engine owns timing and token movement.'],
  ['network','DATA / ACK → NETWORK','Tokens cross links; this explorer is conceptual, not a completeness claim.']
];
---
<div class="explorer" data-explorer><div class="diagram" role="img" aria-label="Layered Transputer path from application to physical network"><svg viewBox="0 0 720 360" aria-hidden="true"><path d="M80 48H640M80 108H640M80 168H640M80 228H640M80 288H640" /><path class="pulse" d="M80 48H640M80 108H640M80 168H640M80 228H640M80 288H640" />{layers.map((_,i)=><circle cx={80+i*112} cy="168" r="5" />)}</svg>{layers.map(([id,label],i)=><button class:list-active={i===0} data-layer={id} style={`--i:${i}`} aria-controls="layer-detail">{label}</button>)}</div><p id="layer-detail" class="detail" aria-live="polite">{layers[0][2]}</p></div>
<script>const root=document.querySelector('[data-explorer]'); if(root){const detail=root.querySelector('#layer-detail'); const copy: Record<string,string>={application:'Processes express intent and exchange messages.',vm:'A controlled execution boundary for experiments.',core:'Scheduler, timers, channels, microcode and datapath meet here.',service:'A boundary between logical channels and physical work.',phy:'The physical engine owns timing and token movement.',network:'Tokens cross links; this explorer is conceptual, not a completeness claim.'}; root.querySelectorAll<HTMLButtonElement>('[data-layer]').forEach((button)=>button.addEventListener('click',()=>{root.querySelectorAll('[data-layer]').forEach(b=>b.classList.remove('list-active'));button.classList.add('list-active'); const item=copy[button.dataset.layer ?? '']; if(detail && item) detail.textContent=item;}));}</script>
<style>.explorer{border:1px solid var(--line);border-radius:1rem;background:#0b151c;padding:1rem}.diagram{position:relative;min-height:370px;overflow:hidden}svg{position:absolute;inset:0;width:100%;height:100%;stroke:#294550;stroke-width:2;fill:var(--cyan)}.pulse{stroke:var(--cyan);stroke-dasharray:4 16;animation:flow 5s linear infinite;opacity:.75}.diagram button{position:absolute;left:calc(6% + var(--i)*16%);top:calc(45% + (var(--i) % 2)*20px);transform:translateX(-10%);font:500 .7rem 'DM Mono',monospace;color:var(--ink);background:#152630;border:1px solid var(--line);padding:.55rem;border-radius:.45rem;max-width:130px;cursor:pointer}.diagram button:hover,.diagram button.list-active{border-color:var(--cyan);color:var(--cyan)}.detail{border-top:1px solid var(--line);margin:.5rem 0 0;padding:1rem 0 0}.pulse{transform-origin:center}@keyframes flow{to{stroke-dashoffset:-100}}@media(prefers-reduced-motion:reduce){.pulse{animation:none}}</style>
