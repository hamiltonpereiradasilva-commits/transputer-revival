---
import TransputerContact from "./TransputerContact.astro";
const locale = Astro.currentLocale || Astro.url.pathname.split("/")[1] || "en";
const german = locale === "de";
---
<footer><div class="shell footer-grid"><div><div class="eyebrow">{german ? "Offene Technik / überprüfbare Nachweise" : "Open engineering / measured evidence"}</div><p>{german ? "Transputer Revival ist ein unabhängiges Bildungs- und Experimentalprojekt. Wissen bleibt frei zugänglich; Unterstützung ist freiwillig." : "Transputer Revival is an independent educational and experimental project. Public learning stays open; support is optional."}</p></div><div><p><a href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival">GitHub ↗</a> · <a href="/en/support/">Support</a> · <a href="/pt/support/">Apoio</a> · <a href="/de/support/">Unterstützen</a></p><p class="mono">No trackers · No accounts · Static-first</p><p>© {new Date().getFullYear()} Transputer Revival</p></div></div>  <TransputerContact />
</footer>
<style>footer{border-top:1px solid var(--line);padding:3rem 0}.footer-grid{display:grid;gap:2rem}@media(min-width:700px){.footer-grid{grid-template-columns:1.5fr 1fr;align-items:end}}</style>
