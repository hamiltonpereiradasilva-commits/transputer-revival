---
import { latestNews, type NewsLocale } from '../data/news';
const { locale = 'en', limit = 3 } = Astro.props as {locale?: NewsLocale; limit?: number};
const labels = locale === 'pt' ? {heading:'Últimas atualizações',eyebrow:'Diário de engenharia',all:'Ver todas as notícias →',more:'Detalhes →',completed:'Marco concluído',experimental:'Demonstração experimental',validation:'Em validação'} : {heading:'Latest updates',eyebrow:'Engineering log',all:'View all news →',more:'Details →',completed:'Milestone completed',experimental:'Experimental demonstration',validation:'Under validation'};
---
<section class="section updates" aria-labelledby="latest-updates"><div class="shell"><div class="updates-heading"><div><div class="eyebrow">{labels.eyebrow}</div><h2 id="latest-updates">{labels.heading}</h2></div><a class="mono" href={`/${locale}/news/`}>{labels.all}</a></div><div class="grid grid-3">{latestNews.slice(0,limit).map(item=><article class="card news-card"><div class="news-meta"><time datetime={item.date}>{item.date}</time><span>{item.category}</span></div><span class="news-status">{labels[item.status]}</span><h3>{item.title[locale]}</h3><p>{item.summary[locale]}</p><a class="mono" href={item.href[locale]}>{labels.more}</a></article>)}</div></div></section>
<style>.updates{border-block:1px solid var(--line);background:var(--surface,#101c22)}.updates-heading{display:flex;justify-content:space-between;align-items:end;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}.updates-heading h2{margin-bottom:0}.updates-heading a,.news-card a{color:var(--cyan)}.news-card{display:flex;flex-direction:column;align-items:start}.news-card h3{margin:.85rem 0}.news-card p{flex:1}.news-meta{display:flex;gap:.75rem;flex-wrap:wrap;font:.75rem 'DM Mono',monospace;color:var(--muted)}.news-status{margin-top:.85rem;padding:.3rem .55rem;border:1px solid var(--line);border-radius:3px;font-size:.76rem;color:var(--cyan)}</style>
