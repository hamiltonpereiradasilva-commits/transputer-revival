---
import ArchitectureExplorer from './ArchitectureExplorer.astro';
import StatusBadge from './StatusBadge.astro';
import { t425SimContent, type T425Locale } from '../data/t425-sim';
const { locale } = Astro.props as { locale: T425Locale };
const copy = t425SimContent[locale];
---
<div class="project-page">
  <div class="project-status"><StatusBadge status="IN_TEST" /><p>{copy.statusNote}</p></div>
  <section class="milestone" aria-labelledby="milestone"><div class="eyebrow">F161-FIX19 · EXPERIMENTAL PASS</div><h2 id="milestone">{copy.milestoneTitle}</h2><p>{copy.milestoneIntro}</p><ul class="evidence-list">{copy.milestoneEvidence.map((item) => <li>{item}</li>)}</ul><p class="milestone-caveat">{copy.milestoneCaveat}</p></section>
  <section class="terminal-proof" aria-labelledby="terminal-proof"><div class="eyebrow">29 OCT 2026 · macOS TERMINAL · REPRODUCED EXPERIMENTAL RESULT</div><h2 id="terminal-proof">{locale === 'pt' ? 'Resultado obtido no Terminal' : 'Result reproduced in Terminal'}</h2><p>{locale === 'pt' ? 'Execução direta do simulador T425-SIM experimental já compilado, em Docker no macOS. A saída abaixo foi observada na execução real, não impressa por um comando echo.' : 'Direct execution of the already compiled experimental T425-SIM simulator in Docker on macOS. The output below was observed during the actual run, not printed by an echo command.'}</p><pre class="terminal-output"><code>{'F99_HOST_REQUEST_RECEIVED event=1 endpoint=0 length=24 hex=16000f010000000e0048656c6c6f20776f726c642e2e2e71\nHello world...\nF99_HOST_REQUEST_RECEIVED event=2 endpoint=0 length=8 hex=060023ffc99a3b0e\nF101_SERVICE_TERMINATE event=2 frame_validated=1 exit_status=0 response_emitted=0'}</code></pre><p class="milestone-caveat">{locale === 'pt' ? 'Resultado parcial e reproduzível: SP_PUTS (24 bytes), impressão de Hello world... e SP_EXIT (8 bytes, status 0) no harness experimental, com ACKs simulados. Não constitui validação da PHY física, do CORE canônico nem equivalência completa ao IMS T425 Rev.C.' : 'Partial, reproducible result: SP_PUTS (24 bytes), Hello world... output, and SP_EXIT (8 bytes, status 0) in the experimental harness with simulated ACKs. This does not validate the physical PHY, canonical CORE, or full IMS T425 Rev.C equivalence.'}</p></section>
  <section class="audit-gate" aria-labelledby="audit-gate"><div class="eyebrow">F161-FIX21 · 29 OCT 2026 · ARCHITECTURAL REVIEW</div><h2 id="audit-gate">{locale === 'pt' ? 'Estado da integração canônica' : 'Canonical integration status'}</h2><p>{locale === 'pt' ? 'A revisão documental posterior ao Hello World preservou o sucesso experimental, mas não autorizou a integração dos deltas no CORE canônico.' : 'The post–Hello World documentary review preserves the experimental result but does not authorize promotion of the deltas into the canonical CORE.'}</p><ul class="evidence-list"><li>{locale === 'pt' ? 'F28 — já presente no canônico; nenhuma reaplicação.' : 'F28 — already present in the canonical CORE; no reapplication.'}</li><li>{locale === 'pt' ? 'F36 — bloqueado: divergências funcionais em UNPACKSN/NORM; não usar como regra global.' : 'F36 — blocked: functional divergences in UNPACKSN/NORM; not safe as a global rule.'}</li><li>{locale === 'pt' ? 'F45 — bloqueado: strobes/commit e divergência NEXTMPC em 0x0A2 ainda sem fechamento.' : 'F45 — blocked: strobe/commit contract and NEXTMPC divergence at 0x0A2 remain unresolved.'}</li><li>{locale === 'pt' ? 'F98 — bloqueado: contrato físico Rev.C de Next/clear e validação isolada pendentes.' : 'F98 — blocked: physical Rev.C Next/clear contract and isolated validation remain open.'}</li></ul><p class="milestone-caveat">{locale === 'pt' ? 'Próxima frente: planejar a integração dos serviços SP_PUTS/SP_EXIT na VM/ISERVER, sem incorporar o harness ao CORE e sem modificar a PHY.' : 'Next workstream: plan SP_PUTS/SP_EXIT integration in VM/ISERVER, without embedding the harness in the CORE or changing the PHY.'}</p></section>
  <section aria-labelledby="baseline"><h2 id="baseline">{copy.baselineTitle}</h2><p>{copy.baselineIntro}</p><ArchitectureExplorer /></section>
  <section aria-labelledby="core"><h2 id="core">{copy.coreTitle}</h2><p>{copy.coreIntro}</p><ul class="pill-list">{copy.core.map((item) => <li>{item}</li>)}</ul></section>
  <section aria-labelledby="boundary"><h2 id="boundary">{copy.boundaryTitle}</h2><p>{copy.boundaryIntro}</p><div class="boundary-grid">{copy.boundary.map(([name, text]) => <article class="card"><div class="eyebrow">{name}</div><p>{text}</p></article>)}</div></section>
  <section aria-labelledby="checkpoint"><h2 id="checkpoint">{copy.checkpointTitle}</h2><p>{copy.checkpointIntro}</p><ul class="evidence-list">{copy.checkpoint.map((item) => <li>{item}</li>)}</ul></section>
  <section aria-labelledby="limitations"><h2 id="limitations">{copy.limitationsTitle}</h2><p>{copy.limitationsIntro}</p><h3>{copy.outsideLabel}</h3><ul class="limitations">{copy.outside.map((item) => <li>{item}</li>)}</ul><h3>{copy.serviceLabel}</h3><ul class="limitations">{copy.limitations.map((item) => <li>{item}</li>)}</ul></section>
</div>
<style>
  .terminal-output{overflow-x:auto;padding:1.25rem;border:1px solid var(--line);border-radius:.7rem;background:#071116;color:#c4f5d7;font-size:.9rem;line-height:1.7;white-space:pre}.project-page{display:grid;gap:4rem}.milestone{border:1px solid var(--line);border-radius:1rem;padding:2rem;background:#0e1b22}.milestone-caveat{border-left:3px solid var(--amber);padding-left:1rem;color:var(--muted)}.project-page section{border-top:1px solid var(--line);padding-top:2.5rem}.project-page h2{font-size:clamp(1.7rem,3vw,2.5rem)}.project-status{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;padding:1rem 1.2rem;border:1px solid #695232;background:#211b12;border-radius:.8rem}.project-status p{margin:0;color:var(--ink);max-width:70ch}.pill-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.65rem;padding:0;list-style:none}.pill-list li{border:1px solid var(--line);border-radius:.6rem;padding:.75rem;color:var(--ink);background:#0e1b22}.boundary-grid{display:grid;gap:1rem}@media(min-width:760px){.boundary-grid{grid-template-columns:repeat(3,1fr)}}.evidence-list,.limitations{display:grid;gap:.7rem;padding-left:1.25rem}.evidence-list li,.limitations li{color:var(--muted);line-height:1.65}.evidence-list li::marker{color:var(--cyan)}.limitations li::marker{color:var(--amber)}
</style>
