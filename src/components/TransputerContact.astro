---
const path = Astro.url.pathname;
const english = /^\/en(?:\/|$)/i.test(path) || /(?:^|\/)english(?:\/|$)/i.test(path);
const t = english ? {
  title: 'Get in Touch', institution: 'Professor at the Federal University of Technology – Paraná (UTFPR), Medianeira Campus',
  department: 'Department of Computer Science', areas: 'Teaching areas',
  subjects: ['Advanced Hardware Architecture', 'Neural Networks', 'Assembly Language', 'Data Communications', 'Operating Systems'],
  phone: 'Phone / WhatsApp', address: 'Contact address', country: 'Brazil', email: 'Email',
  whatsapp: 'Chat on WhatsApp'
} : {
  title: 'Entre em contato', institution: 'Professor da Universidade Tecnológica Federal do Paraná (UTFPR) — Campus Medianeira',
  department: 'Departamento de Ciência da Computação', areas: 'Áreas de docência',
  subjects: ['Arquitetura Avançada de Hardware', 'Redes Neurais', 'Linguagem de Montagem', 'Comunicação de Dados', 'Sistemas Operacionais'],
  phone: 'Telefone / WhatsApp', address: 'Endereço de contato', country: 'Brasil', email: 'E-mail',
  whatsapp: 'Conversar pelo WhatsApp'
};
---
<section class="tr-contact" aria-label={t.title}>
  <h2>{t.title}</h2>
  <h3>Hamilton Pereira da Silva, MSc</h3>
  <p class="tr-institution">{t.institution}</p>
  <p>{t.department}</p>
  <p><strong>{t.areas}:</strong> {t.subjects.join(' · ')}</p>
  <div class="tr-details">
    <p><strong>{t.email}:</strong> <a href="mailto:hamilton.pereiradasilva@gmail.com">hamilton.pereiradasilva@gmail.com</a></p>
    <p><strong>{t.phone}:</strong> <a href="tel:+5545988367816">+55 45 98836-7816</a> · <a href="https://wa.me/5545988367816" target="_blank" rel="noopener noreferrer">{t.whatsapp}</a></p>
    <p><strong>{t.address}:</strong> Rua Arlindo Zago, 3382, Medianeira, Paraná, CEP 85720-358, {t.country}</p>
  </div>
</section>
<style>
  .tr-contact { box-sizing:border-box; width:100%; max-width:1100px; margin:2rem auto 0; padding:1.5rem; border:1px solid var(--border-color, #64748b66); border-radius:14px; background:var(--card-background, rgba(120,130,150,.08)); color:inherit; overflow-wrap:anywhere; }
  .tr-contact h2 { margin:0 0 .65rem; font-size:1.35rem; line-height:1.3; }
  .tr-contact h3 { margin:.25rem 0; font-size:1.1rem; line-height:1.4; }
  .tr-contact p { margin:.5rem 0; line-height:1.6; }
  .tr-contact .tr-institution { font-weight:600; }
  .tr-contact .tr-details { margin-top:1rem; padding-top:.7rem; border-top:1px solid var(--border-color, #64748b55); }
  .tr-contact a { color:inherit; text-decoration:underline; text-underline-offset:3px; }
  .tr-contact a:hover,.tr-contact a:focus-visible { text-decoration-thickness:2px; }
  @media(max-width:600px) { .tr-contact { padding:1rem; margin-top:1rem; } }
</style>
