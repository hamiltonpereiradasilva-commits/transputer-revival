---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
type Locale = 'en' | 'pt' | 'de' | 'fr';
type Alternates = Partial<Record<Locale, string>>;
interface Props { title: string; description: string; locale?: Locale; alternates?: Alternates; }
const { title, description, locale = 'en', alternates = {} } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://transputerrevival.org');
const openGraphLocales: Record<Locale, string> = { en: 'en_US', pt: 'pt_BR', de: 'de_DE', fr: 'fr_FR' };
const alternateEntries = Object.entries(alternates) as [Locale, string][];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Transputer Revival</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateEntries.map(([code, path]) => <link rel="alternate" hreflang={code} href={new URL(path, canonical)} />)}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, canonical)} />}
    <meta property="og:title" content={`${title} · Transputer Revival`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Transputer Revival" />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {alternateEntries.filter(([code]) => code !== locale).map(([code]) => <meta property="og:locale:alternate" content={openGraphLocales[code]} />)}
    <meta property="og:type" content="website" />
  </head>
  <body><Header locale={locale} /><main id="main"> <slot /> </main><Footer /></body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{--ink:#e7edf3;--muted:#91a1ae;--bg:#081016;--panel:#101b23;--line:#223541;--cyan:#6ee7d4;--amber:#f3b562;--focus:#fff3a3;font-family:'Space Grotesk',system-ui,sans-serif;color:var(--ink);background:var(--bg)}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% -10%,#16333a 0,transparent 36rem),var(--bg);min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.shell{max-width:1180px;margin:0 auto;padding:0 1.25rem}.eyebrow{font:500 .74rem 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan)}h1,h2,h3{letter-spacing:-.04em;line-height:1.05;margin:0 0 1rem}h1{font-size:clamp(2.6rem,7vw,6.2rem);max-width:11ch}h2{font-size:clamp(2rem,4vw,3.3rem)}h3{font-size:1.25rem}p{color:var(--muted);line-height:1.7;max-width:68ch}.section{padding:5.5rem 0}.grid{display:grid;gap:1rem}.button{display:inline-flex;align-items:center;gap:.5rem;padding:.78rem 1rem;border:1px solid var(--cyan);border-radius:999px;color:var(--cyan);font-weight:600}.button:hover{background:var(--cyan);color:var(--bg)}.card{border:1px solid var(--line);background:linear-gradient(145deg,#12212a,#0d171e);border-radius:1rem;padding:1.35rem}.mono{font-family:'DM Mono',monospace}
@media(min-width:800px){.shell{padding:0 2rem}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-2{grid-template-columns:repeat(2,1fr)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.001ms!important;transition-duration:.001ms!important}}
</style>
