---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { projects } from '../../data/project-status';
const sections = {
 learn: ['Lernen','Parallelität verstehen – Schritt für Schritt.','Grundlagen zu Prozessen, Kanälen, OCCAM und der T425-Architektur. Jede Lektion unterscheidet dokumentiertes Verhalten, Experimente und noch offene Fragen.'],
 labs: ['Labor','Jedes Experiment braucht nachvollziehbare Messungen.','Versuchsaufbau, Firmware, Eingaben, erwartete Ergebnisse, beobachtete Messwerte und Grenzen werden getrennt dokumentiert.'],
 projects: ['Projekte','Offene Entwicklung mit überprüfbarem Status.','Die Projektkennzeichnung beschreibt den verfügbaren Nachweis, nicht den Reifegrad eines fertigen Produkts.'],
 architecture: ['Architektur','Vom Programm bis zum physischen Link.','Die Architektur trennt Anwendung und VM, den mikroprogrammierten CORE, Link-Service und PHY. Der Ausführungspfad lautet OPR → CROM → MIR → Mikrosequencer → Datapath.'],
 history: ['Geschichte','Transputer-Technik anhand historischer Quellen.','Originalunterlagen von INMOS, Befehlssatz, Mikroarchitektur und OCCAM werden mit Herkunftsangaben eingeordnet. Moderne Rekonstruktionen bleiben als solche gekennzeichnet.'],
 documentation: ['Dokumentation','Quellen, Interpretation und Reproduktion.','Originaldokumente, technische Analysen, Versuchsprotokolle und Implementierungsnotizen werden getrennt geführt. Die Dokumentation nennt bekannte Grenzen und offene Fragen.'],
 community: ['Community','Wissen teilen und Ergebnisse vergleichen.','Mitwirkende können reproduzierbare Experimente, Dokumentation, Hardwarebeobachtungen und Softwarebeiträge über GitHub einbringen.'],
 support: ['Unterstützen','Offene technische Bildung ermöglichen.','Freiwillige Beiträge können Leiterplatten, Bauteile, Messgeräte und Dokumentation unterstützen. Technische Inhalte bleiben öffentlich zugänglich; auf dieser Website ist kein Zahlungssystem integriert.'],
 about: ['Über uns','Ein unabhängiges Bildungs- und Entwicklungsprojekt.','Transputer Revival dokumentiert Forschung, praktische Versuche und die Wiederentdeckung der Transputer-Architektur. Es ist kein offizielles INMOS- oder Universitätsprojekt.']
} as const;
export function getStaticPaths(){return Object.keys(sections).map(section=>({params:{section},props:{section}}));}
const {section}=Astro.props; const [title,intro,body]=sections[section as keyof typeof sections];
---
<SiteLayout title={title} description={intro} locale="de" alternates={{de:`/de/${section}/`,en:`/en/${section}/`,pt:`/pt/${section}/`}}>
<section class="section"><div class="shell narrow"><div class="eyebrow">Transputer Revival / {title}</div><h1>{title}</h1><p class="lead">{intro}</p><div class="card"><p>{body}</p></div>
{section==='projects'&&<div class="projects">{projects.map(project=><article class="card"><div class="head"><h2>{project.name}</h2><StatusBadge status={project.status}/></div><p>{project.slug==='t425-visual-debugger'?'Animierter, didaktischer Debugger für Mikrozyklen und Datapath; V0.1 in Entwicklung.':project.slug==='t425-sim'?'Experimentelle, evidenzorientierte Rekonstruktion des INMOS IMS T425.':project.slug==='linkusb'?'RP2040-Platine mit zwei unabhängigen Transputer-Links; physische Prüfung mit INMOS-Gegenstelle steht noch aus.':'Geplantes Werkzeug im Transputer-Revival-Projekt.'}</p>{['t425-sim','linkusb','t425-visual-debugger'].includes(project.slug)&&<a href={`/de/projects/${project.slug}/`}>Projekt ansehen →</a>}</article>)}</div>}
{section==='architecture'&&<div class="card diagram"><code>OCCAM / VM → CORE (OPR → CROM → MIR → Datapath) → Link-Service → PHY</code><p>Konzeptionelle Darstellung; keine Aussage über vollständige T425-Kompatibilität.</p></div>}
{section==='documentation'&&<div class="card"><h2>Dokumentationsbereiche</h2><p>INMOS-Originalquellen · Architektur-Analysen · Versuchsberichte · Firmware und Software · Bekannte Einschränkungen</p></div>}
{section==='labs'&&<div class="card"><h2>Laborprotokoll</h2><p>Fragestellung → Aufbau → Eingaben → Messung → Vergleich → Einschränkungen → Reproduktionsschritte</p></div>}
{section==='support'&&<div class="projects"><article class="card"><h2>Finanzielle Unterstützung</h2><p>Freiwillige Unterstützung für Prototypen und technische Dokumentation. Für eine PayPal-Abstimmung bitte Kontakt aufnehmen; dies ist kein Checkout.</p><a href="mailto:ham_cwb@hotmail.com?subject=Transputer%20Revival%20Support">Kontakt per E-Mail →</a></article><article class="card"><h2>Gerätespenden</h2><p>Transputer, TRAMs, Platinen, Komponenten, Messgeräte und historische Unterlagen. Zustand und Versand bitte vorab abstimmen.</p><a href="mailto:ham_cwb@hotmail.com?subject=Transputer%20Revival%20Equipment">Geräte anbieten →</a></article><article class="card"><h2>Technische Beiträge</h2><p>Firmware, OCCAM, Tests, Dokumentation und Hardwareentwicklung über Issues und Pull Requests.</p><a href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival/issues">Auf GitHub mitarbeiten →</a></article><article class="card"><h2>Institutionelle Förderung</h2><p>Kooperationen für Materialien, Fertigung und Forschung unter Wahrung der technischen Unabhängigkeit.</p><a href="mailto:ham_cwb@hotmail.com?subject=Transputer%20Revival%20Sponsorship">Kontakt aufnehmen →</a></article></div>}
{section==='community'&&<p><a class="button" href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival">Zur GitHub-Community ↗</a></p>}
</div></section></SiteLayout>
<style>.narrow{max-width:1020px}.lead{font-size:1.2rem}.projects{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;margin-top:1.5rem}.projects h2{font-size:1.35rem}.head{display:flex;justify-content:space-between;gap:.5rem;align-items:start}.card a{color:var(--cyan)}.diagram{margin-top:1rem;overflow:auto}.diagram code{color:var(--cyan)}</style>