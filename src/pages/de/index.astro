---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeroNetwork from '../../components/HeroNetwork.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import {projects} from '../../data/project-status';
---
<SiteLayout title="Lernen, bewahren, experimentieren" description="Unabhängiges Bildungs- und Technikportal zur Transputer-Architektur." locale="de" alternates={{en:'/en/',pt:'/pt/',de:'/de/',fr:'/fr/'}}>
<section class="section hero"><div class="shell hero-grid"><div><div class="eyebrow">Bildung · Bewahrung · Offene Technik</div><h1>Parallelität begreifen.</h1><p class="lead">Transputer Revival verbindet historische INMOS-Dokumentation, moderne Rekonstruktionen und reproduzierbare Experimente. Entdecken Sie OCCAM, die T425-Mikroarchitektur und physische Transputer-Links.</p><div class="actions"><a class="button" href="/de/learn/">Jetzt lernen ↗</a><a class="button" href="/de/projects/">Projekte entdecken ↗</a></div></div><HeroNetwork /></div></section>
<section class="section support"><div class="shell"><div class="eyebrow">Offenes Gemeinschaftsprojekt</div><h2>GitHub, Förderung und Spenden</h2><p>Quellcode ansehen, technische Beiträge leisten oder die Bewahrung der Transputer-Technologie mit Geräten, Dokumentation und freiwilliger Unterstützung fördern.</p><div class="actions"><a class="button" href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival">GitHub öffnen ↗</a><a class="button" href="/de/support/">Unterstützen ↗</a></div></div></section>
<section class="section"><div class="shell"><div class="eyebrow">Architektur verstehen</div><h2>Vom Befehl zum Mikrozyklus</h2><p>Die Architektur trennt OPR, CROM, MIR, Mikrosequencer, Datapath, Scheduler und physische Links. Technische Behauptungen werden mit ihrem jeweiligen Nachweis eingeordnet.</p><a class="button" href="/de/architecture/">Architektur erkunden →</a></div></section>
<section class="section"><div class="shell"><div class="eyebrow">Projekte</div><h2>Offene Entwicklung, klare Grenzen.</h2><div class="grid grid-2">{projects.map(p=><article class="card"><div class="head"><h3>{p.name}</h3><StatusBadge status={p.status}/></div><p>{p.slug==='t425-visual-debugger'?'Geplanter animierter T425-Debugger für die didaktische Analyse von Mikrozyklen.':p.slug==='t425-sim'?'Experimentelle Rekonstruktion eines dokumentierten T425-Ausführungspfads.':p.slug==='linkusb'?'RP2040-USB-Schnittstelle mit zwei physischen Transputer-Link-Pfaden.':'Geplantes Werkzeug für reproduzierbare Experimente.'}</p>{['t425-sim','linkusb','t425-visual-debugger'].includes(p.slug)&&<a href={`/de/projects/${p.slug}/`}>Projektseite →</a>}</article>)}</div></div></section>
</SiteLayout>
<style>.hero{padding-top:6rem}.hero-grid{display:grid;gap:2rem;align-items:center}.lead{font-size:1.15rem}.actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.4rem}.support{border-block:1px solid var(--line);background:var(--panel)}.head{display:flex;gap:1rem;align-items:start;justify-content:space-between}.card a{color:var(--cyan)}@media(min-width:850px){.hero-grid{grid-template-columns:1fr 1fr}}</style>