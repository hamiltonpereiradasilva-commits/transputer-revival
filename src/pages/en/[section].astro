---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TechnicalSectionBody from '../../components/TechnicalSectionBody.astro';
const sections = { learn:['Learn','Build a mental model before you build a board.','Short lessons will connect processes, channels, OCCAM and the T425 without pretending that a diagram is a complete implementation.'], labs:['Labs','Experiments are claims with a measurement attached.','The lab notebook will collect reproducible setups, firmware artifacts, observations and limits.'], projects:['Projects','Open work, with status you can inspect.','These projects are presented as evolving work. A badge reports the evidence level rather than promising a finished product.'], architecture:['Architecture','A layered machine rewards careful boundaries.','Explore the conceptual path from application and VM through CORE, link service, PHY and physical network.'], history:['History','A technical history told with primary sources.','This space will place Transputer ideas in context and link to sources with provenance, licenses and attribution.'], documentation:['Documentation','Notes that help you reproduce the next step.','Reference pages will separate original documentation, interpretation and modern experiment.'], community:['Community','Learn in public, compare measurements.','A future community space will make it easy to share observations without requiring an account or a platform lock-in.'], support:['Support','Keep the work open.','Voluntary support may help with prototype PCBs, components, measurement equipment and documentation. Public technical access will remain open; no payment system is connected here.'], about:['About','An independent project for curious engineers.','Transputer Revival is not an official university or institutional project. It is a careful, open record of learning and experimentation.'] };
export function getStaticPaths(){return ['learn','labs','projects','architecture','history','documentation','community','support','about'].map(section=>({params:{section},props:{section}}));}
const { section } = Astro.props; const [title, intro, body] = sections[section as keyof typeof sections];
const alternates = { en: `/en/${section}/`, pt: `/pt/${section}/` };
---
<SiteLayout title={title} description={intro} locale="en" alternates={alternates}><section class="section"><div class="shell narrow"><div class="eyebrow">Transputer Revival / {section}</div><h1>{title}</h1><p class="lead">{intro}</p>{['architecture','projects','documentation','labs'].includes(section) ? <TechnicalSectionBody section={section} locale="en" /> : <div class="card prose"><p>{body}</p>{section === 'support' && <ul><li>Prototype PCBs and components</li><li>Measurement equipment</li><li>Documentation and hosting when needed</li></ul>}</div>}{section === 'support' && <div class="support-content"><div class="support-grid">
<article class="card"><h2>Financial support</h2><p>Help fund prototypes, PCBs, components, instruments and documentation. To arrange PayPal support, contact the email below; this is not a checkout link.</p><a class="button" href="mailto:ham_cwb@hotmail.com?subject=Transputer%20Revival%20PayPal">PayPal: ham_cwb@hotmail.com ↗</a><p>Patreon: campaign not yet linked.</p></article>
<article class="card"><h2>Equipment donations</h2><p>We welcome offers of Transputers, TRAMs, boards, memory, components, tools, test equipment and documentation. Please agree on condition, suitability and shipping first.</p><a class="button" href="mailto:ham_cwb@hotmail.com?subject=Transputer%20Revival%20Equipment">Offer equipment ↗</a></article>
<article class="card"><h2>Technical contributions</h2><p>Contribute firmware, emulation, electronics, PIO, tests, OCCAM, documentation and technical review. Discuss scope through issues and submit pull requests with tests and evidence.</p><a class="button" href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival/issues">Propose a contribution ↗</a><p><a href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival/pulls">Pull requests →</a></p></article>
<article class="card"><h2>Institutional sponsorship</h2><p>Companies, labs and institutions can sponsor fabrication, materials, services and research. Recognition will be agreed without compromising technical independence.</p><a class="button" href="mailto:ham_cwb@hotmail.com?subject=Transputer%20Revival%20Sponsorship">Discuss sponsorship ↗</a></article>
</div><div class="card recognition"><h2>Technical contributors</h2><p>A named contributor roster will be published after acceptance and consent. The public record of merged contributions is on GitHub.</p><a href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival/graphs/contributors">View GitHub contributors ↗</a></div></div>}{section === 'community' && <div class="card recognition"><h2>Join the community</h2><p>Share measurements, tests and documentation through GitHub.</p><a class="button" href="https://github.com/hamiltonpereiradasilva-commits/transputer-revival">GitHub ↗</a><p><a href="/en/support/">Ways to contribute →</a></p></div>}</div></section></SiteLayout>
<style>.narrow{max-width:980px}.lead{font-size:1.25rem}.prose{margin-top:2rem}.support-grid{display:grid;gap:1rem;margin-top:2rem}.support-grid h2,.recognition h2{font-size:1.5rem}.recognition{margin-top:1rem}.support-content a:not(.button),.recognition a:not(.button){color:var(--cyan)}@media(min-width:760px){.support-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}li{color:var(--muted);line-height:1.8}</style>
