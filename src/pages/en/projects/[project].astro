---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import T425SimProject from '../../../components/T425SimProject.astro';
import LinkUsbProject from '../../../components/LinkUsbProject.astro';
import T425VisualDebuggerProject from '../../../components/T425VisualDebuggerProject.astro';
import T425ControlCenterProject from '../../../components/T425ControlCenterProject.astro';
import { t425SimContent } from '../../../data/t425-sim';
import { linkUsbContent } from '../../../data/linkusb';
import { visualDebuggerContent } from '../../../data/t425-visual-debugger';
import { controlCenterContent } from '../../../data/t425-control-center';
export function getStaticPaths(){ return ['t425-sim','linkusb','t425-visual-debugger','t425-control-center'].map(project => ({ params: { project }, props: { locale: 'en' } })); }
const project = Astro.params.project;
const copy = project === 'linkusb' ? linkUsbContent.en : project === 't425-visual-debugger' ? visualDebuggerContent.en : project === 't425-control-center' ? controlCenterContent.en : t425SimContent.en;
---
<SiteLayout title={copy.title} description={copy.description} locale="en" alternates={{ en: `/en/projects/${project}/`, pt: `/pt/projects/${project}/`, de: `/de/projects/${project}/` }}><section class="section"><div class="shell project-shell"><div class="eyebrow">{copy.eyebrow}</div><h1>{copy.title}</h1>{project === 'linkusb' ? <LinkUsbProject locale="en" /> : project === 't425-visual-debugger' ? <T425VisualDebuggerProject locale="en" /> : project === 't425-control-center' ? <T425ControlCenterProject locale="en" /> : <T425SimProject locale="en" />}</div></section></SiteLayout>
<style>.project-shell{max-width:1040px}.project-shell>h1{margin-top:.5rem}</style>
