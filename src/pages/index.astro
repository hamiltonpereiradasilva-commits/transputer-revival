---
import { locales } from '../data/content';
---
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Transputer Revival — choose a language</title><meta name="description" content="Education, preservation and open engineering around Transputer architecture."/></head><body><main><p class="eyebrow">Transputer Revival</p><h1>Choose your language</h1><p>Preserving the Transputer through education, open hardware and experimental implementation.</p><nav>{Object.entries(locales).map(([code,label])=><a href={`/${code}/`} lang={code}>{label}<span>→</span></a>)}</nav></main></body></html><style>:root{font-family:system-ui,sans-serif;color:#e7edf3;background:#081016}body{margin:0;min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 70% 20%,#16333a,transparent 45%),#081016}main{max-width:600px;padding:2rem}.eyebrow{color:#6ee7d4;font:500 .75rem monospace;letter-spacing:.16em;text-transform:uppercase}h1{font-size:clamp(2.5rem,8vw,5rem);letter-spacing:-.06em;margin:.8rem 0}p{color:#91a1ae;line-height:1.6}nav{display:grid;gap:.7rem;margin-top:2rem}a{display:flex;justify-content:space-between;border:1px solid #223541;border-radius:.7rem;padding:1rem;color:#e7edf3;text-decoration:none}a:hover{border-color:#6ee7d4;color:#6ee7d4}span{color:#6ee7d4}</style>
