---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TechnicalSectionBody from '../../components/TechnicalSectionBody.astro';
const sections = { learn:['Aprender','Construa um modelo mental antes de montar uma placa.','Lições curtas vão conectar processos, canais, OCCAM e o T425 sem fingir que um diagrama é uma implementação completa.'], labs:['Laboratórios','Experimentos são afirmações acompanhadas de medição.','O caderno de laboratório reunirá montagens reproduzíveis, artefatos de firmware, observações e limites.'], projects:['Projetos','Trabalho aberto, com status verificável.','Os projetos são apresentados como trabalho em evolução. O status indica o nível de evidência, não uma promessa de produto terminado.'], architecture:['Arquitetura','Uma máquina em camadas exige limites claros.','Explore o caminho conceitual entre aplicação, VM, CORE, serviço de link, PHY e rede física.'], history:['História','Uma história técnica baseada em fontes primárias.','Este espaço contextualizará ideias do Transputer e registrará origem, licença e atribuição dos materiais.'], documentation:['Documentação','Notas para reproduzir o próximo passo.','As páginas separarão documentação original, interpretação e experimento moderno.'], community:['Comunidade','Aprender em público, comparar medições.','Um espaço futuro facilitará compartilhar observações sem exigir conta ou aprisionamento a uma plataforma.'], support:['Apoio','Mantenha o trabalho aberto.','Apoio voluntário poderá ajudar com PCBs, componentes, instrumentos e documentação. O acesso técnico continuará público; não há pagamento conectado aqui.'], about:['Sobre','Um projeto independente para engenheiros curiosos.','O Transputer Revival não é um projeto oficial de universidade ou instituição. É um registro aberto de aprendizagem e experimentação.'] };
export function getStaticPaths(){return ['learn','labs','projects','architecture','history','documentation','community','support','about'].map(section=>({params:{section},props:{section}}));}
const {section}=Astro.props; const [title,intro,body]=sections[section as keyof typeof sections];
---
<SiteLayout title={title} description={intro} locale="pt"><section class="section"><div class="shell narrow"><div class="eyebrow">Transputer Revival / {section}</div><h1>{title}</h1><p class="lead">{intro}</p>{['architecture','projects','documentation','labs'].includes(section) ? <TechnicalSectionBody section={section} locale="pt" /> : <div class="card prose"><p>{body}</p></div>}</div></section></SiteLayout><style>.narrow{max-width:980px}.lead{font-size:1.25rem}.prose{margin-top:2rem}</style>
