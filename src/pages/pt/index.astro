---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeroNetwork from '../../components/HeroNetwork.astro';
import ArchitectureExplorer from '../../components/ArchitectureExplorer.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { projects } from '../../data/project-status';
---
<SiteLayout title="Aprender, preservar, experimentar" description="Portal independente de educação e engenharia sobre a arquitetura Transputer." locale="pt">
<section class="hero section"><div class="shell hero-grid"><div><div class="eyebrow">Educação · preservação · engenharia aberta</div><h1>Concorrência que cabe nas mãos.</h1><p class="lead">O Transputer Revival é um caderno vivo para entender o Transputer, reconstruir seus experimentos e medir o que as implementações modernas realmente fazem.</p><a class="button" href="/pt/learn/">Começar a aprender <span aria-hidden="true">↗</span></a></div><HeroNetwork /></div></section>
<section class="section"><div class="shell"><div class="eyebrow">Um caminho pela máquina</div><h2>Da teoria à evidência</h2><p>Cada estudo conecta arquitetura original, documentação primária, implementação moderna, experimento, evidência medida e exercícios.</p><ArchitectureExplorer /></div></section>
<section class="section"><div class="shell"><div class="eyebrow">Projetos</div><h2>Experimentos pequenos, status claro.</h2><div class="grid grid-2">{projects.map((project)=><article class="card"><div style="display:flex;justify-content:space-between;gap:1rem;align-items:start"><h3>{project.name}</h3><StatusBadge status={project.status}/></div><p>{project.summary}</p><a href="/pt/projects/" class="mono">Notas do projeto →</a></article>)}</div></div></section>
</SiteLayout>
<style>.hero{padding-top:6rem}.hero-grid{display:grid;gap:3rem;align-items:center}.lead{font-size:1.15rem;max-width:53ch}@media(min-width:850px){.hero-grid{grid-template-columns:1fr 1fr}.hero{padding-top:8rem}}</style>
