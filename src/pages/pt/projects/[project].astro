---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import T425SimProject from '../../../components/T425SimProject.astro';
import LinkUsbProject from '../../../components/LinkUsbProject.astro';
import T425VisualDebuggerProject from '../../../components/T425VisualDebuggerProject.astro';
import { t425SimContent } from '../../../data/t425-sim';
import { linkUsbContent } from '../../../data/linkusb';
import { visualDebuggerContent } from '../../../data/t425-visual-debugger';
export function getStaticPaths(){ return [{ params: { project: 't425-sim' }, props: { locale: 'pt' } }, { params: { project: 'linkusb' }, props: { locale: 'pt' } }, { params: { project: 't425-visual-debugger' }, props: { locale: 'pt' } }]; }
const project = Astro.params.project;
const copy = project === 'linkusb' ? linkUsbContent.pt : project === 't425-visual-debugger' ? visualDebuggerContent.pt : t425SimContent.pt;
---
<SiteLayout title={copy.title} description={copy.description} locale="pt" alternates={{ en: `/en/projects/${project}/`, pt: `/pt/projects/${project}/` }}><section class="section"><div class="shell project-shell"><div class="eyebrow">{copy.eyebrow}</div><h1>{copy.title}</h1>{project === 'linkusb' ? <LinkUsbProject locale="pt" /> : project === 't425-visual-debugger' ? <T425VisualDebuggerProject locale="pt" /> : <T425SimProject locale="pt" />}</div></section></SiteLayout>
<style>.project-shell{max-width:1040px}.project-shell>h1{margin-top:.5rem}</style>
